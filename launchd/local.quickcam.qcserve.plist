<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs qcserve at login. The camera itself only turns on while something watches the feed.
     Installed by `make install-agent`, which fills in the paths. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.quickcam.qcserve</string>
    <key>ProgramArguments</key>
    <array>
        <string>@QCSERVE@</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardErrorPath</key>
    <string>@LOG@</string>
</dict>
</plist>
